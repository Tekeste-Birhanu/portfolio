# Public browser settings. These values are safe to expose, but must be real
# Supabase project values before the client can connect to a project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional public Auth callback origin. Leave empty locally to use the current origin.
VITE_SITE_URL=

# Never place service-role keys, Brevo credentials, or database passwords in
# VITE_* variables. Vite embeds VITE_* values in browser assets.
